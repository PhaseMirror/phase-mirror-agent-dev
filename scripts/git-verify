#!/usr/bin/env python3
"""
git-verify: Governance Verifier for Phase Mirror P2-P3 Signature Requirements
Reference: docs/P3 Signature.txt & ADR_PM_AGENT_003 (Lever H2)

Separates two distinct acts:
1. Document Accept (Governance):
   - Two named persons, holding two distinct keys, each sign the SHA-256 hash
     of canonical ADR bytes.
   - Detached storage: Signatures remain detached, never altering document bytes.
   - State: The document status remains `Proposed` until both signatures verify.
   - Metric: `git verify` or equivalent detached-signature check on that blob.
2. Runtime Unfreeze (Engine Execution):
   - DO NOT RUN. Constraint: No P_2/P_3 keygen, no out-of-band handshake,
     no Sedona compile for a ProofHash, and no R3-FREEZE clear.
   - Condition: Execution is suspended until a public path names the verifier,
     the freeze flag, and the proof object.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

try:
    from cryptography.hazmat.primitives.asymmetric import ed25519
    from cryptography.exceptions import InvalidSignature
    CRYPTO_AVAILABLE = True
except ImportError:
    CRYPTO_AVAILABLE = False


def find_repo_root() -> Path:
    """Find git repository root."""
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
        return Path(res.stdout.strip())
    except Exception:
        # Fallback to current working directory or script parent
        p = Path(__file__).resolve().parent.parent
        return p


REPO_ROOT = find_repo_root()


def get_governance_dir() -> Path:
    if "PHASE_MIRROR_GOVERNANCE_DIR" in os.environ:
        return Path(os.environ["PHASE_MIRROR_GOVERNANCE_DIR"])
    return REPO_ROOT / "governance"


def get_signers_file() -> Path:
    return get_governance_dir() / "signers.json"


def get_signatures_file() -> Path:
    return get_governance_dir() / "signatures.json"


def ensure_governance_files():
    """Ensure governance directory and configuration files exist."""
    gov_dir = get_governance_dir()
    gov_dir.mkdir(parents=True, exist_ok=True)
    signers_f = get_signers_file()
    signatures_f = get_signatures_file()
    if not signers_f.exists():
        initial_signers = {
            "version": "1.0",
            "description": "Registry of authorized governance key holders for P2-P3 document acceptance (H2 lever)",
            "signers": []
        }
        with open(signers_f, "w", encoding="utf-8") as f:
            json.dump(initial_signers, f, indent=2)

    if not signatures_f.exists():
        initial_signatures = {
            "version": "1.0",
            "description": "Detached signatures ledger for Phase Mirror governed documents",
            "documents": {}
        }
        with open(signatures_f, "w", encoding="utf-8") as f:
            json.dump(initial_signatures, f, indent=2)


def canonical_sha256(path: Path) -> Tuple[str, bytes]:
    """Compute SHA-256 of canonical document bytes."""
    with open(path, "rb") as f:
        data = f.read()
    digest = hashlib.sha256(data).digest()
    return digest.hex(), digest


def load_signers() -> Dict[str, Any]:
    ensure_governance_files()
    try:
        with open(get_signers_file(), "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"signers": []}


def save_signers(data: Dict[str, Any]):
    ensure_governance_files()
    with open(get_signers_file(), "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


def load_signatures_ledger() -> Dict[str, Any]:
    ensure_governance_files()
    try:
        with open(get_signatures_file(), "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"documents": {}}


def save_signatures_ledger(data: Dict[str, Any]):
    ensure_governance_files()
    with open(get_signatures_file(), "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


def get_default_adr_files() -> List[Path]:
    """Find all default governed ADR documents in the repo."""
    files: List[Path] = []
    candidates = [
        REPO_ROOT / "phase-mirror-gpt" / "ADR",
        REPO_ROOT / "docs",
    ]
    for d in candidates:
        if d.exists():
            for f in d.glob("*.md"):
                if f.name.startswith("ADR") or f.name.startswith("0") or "adr" in f.name.lower():
                    files.append(f)
    return sorted(files)


def collect_detached_signatures(doc_path: Path, sha256_hex: str) -> List[Dict[str, str]]:
    """
    Collect detached signatures from:
    1. governance/signatures.json
    2. <doc_path>.signatures.json
    3. Alongside files: <doc_path>.p2.sig, <doc_path>.p3.sig, <doc_path>.sig1, <doc_path>.sig2
    """
    rel_path = str(doc_path.relative_to(REPO_ROOT)) if doc_path.is_relative_to(REPO_ROOT) else str(doc_path)
    collected = []

    # 1. Check central ledger
    ledger = load_signatures_ledger()
    doc_entries = ledger.get("documents", {}).get(rel_path, {})
    if doc_entries:
        # Check matching digest
        stored_digest = doc_entries.get("sha256")
        if stored_digest == sha256_hex:
            for sig in doc_entries.get("signatures", []):
                collected.append(sig)

    # 2. Check local companion json
    local_json = doc_path.with_suffix(doc_path.suffix + ".signatures.json")
    if local_json.exists():
        try:
            with open(local_json, "r", encoding="utf-8") as f:
                data = json.load(f)
                if data.get("sha256") == sha256_hex:
                    collected.extend(data.get("signatures", []))
        except Exception:
            pass

    # 3. Check alongside .sig files
    alongside_patterns = [
        (doc_path.with_name(f"{doc_path.name}.p2.sig"), "P2"),
        (doc_path.with_name(f"{doc_path.name}.p3.sig"), "P3"),
        (doc_path.with_name(f"{doc_path.name}.sig1"), "P2"),
        (doc_path.with_name(f"{doc_path.name}.sig2"), "P3"),
    ]
    for sig_file, role_hint in alongside_patterns:
        if sig_file.exists():
            try:
                content = sig_file.read_text(encoding="utf-8").strip()
                # Could be JSON or hex
                if content.startswith("{"):
                    sig_obj = json.loads(content)
                    collected.append(sig_obj)
                else:
                    lines = content.splitlines()
                    if len(lines) >= 2:
                        pub_hex = lines[0].strip()
                        sig_hex = lines[1].strip()
                        collected.append({
                            "signer": role_hint,
                            "public_key": pub_hex,
                            "signature": sig_hex,
                            "algorithm": "ed25519"
                        })
            except Exception:
                pass

    return collected


def verify_ed25519_signature(pubkey_hex: str, sig_hex: str, digest_bytes: bytes) -> bool:
    """Verify Ed25519 detached signature against 32-byte digest."""
    if not CRYPTO_AVAILABLE:
        raise RuntimeError("cryptography library required for Ed25519 verification")
    try:
        pub_bytes = bytes.fromhex(pubkey_hex)
        sig_bytes = bytes.fromhex(sig_hex)
        if len(pub_bytes) != 32 or len(sig_bytes) != 64:
            return False
        verifying_key = ed25519.Ed25519PublicKey.from_public_bytes(pub_bytes)
        verifying_key.verify(sig_bytes, digest_bytes)
        return True
    except (ValueError, InvalidSignature):
        return False
    except Exception:
        return False


def verify_document(doc_path: Path, verbose: bool = True) -> Dict[str, Any]:
    """
    Verify a single document against P2-P3 signature requirements:
    - 2 named persons holding 2 distinct keys
    - Signatures stay detached
    - Status remains `Proposed` until both signatures verify
    """
    if not doc_path.exists():
        return {
            "path": str(doc_path),
            "exists": False,
            "error": "File not found",
            "status": "ERROR",
            "verified": False
        }

    sha256_hex, digest_bytes = canonical_sha256(doc_path)
    signatures = collect_detached_signatures(doc_path, sha256_hex)

    signers_reg = load_signers()
    registered_pubkeys = {
        s["public_key"].lower(): s.get("name", s.get("role", "Unknown"))
        for s in signers_reg.get("signers", [])
        if "public_key" in s
    }

    verified_keys = set()
    verified_signers = []
    invalid_signatures = 0

    for sig in signatures:
        pub_hex = sig.get("public_key", "").lower().strip()
        sig_hex = sig.get("signature", "").strip()
        signer_name = sig.get("signer", registered_pubkeys.get(pub_hex, "Unknown Signer"))

        if not pub_hex or not sig_hex:
            invalid_signatures += 1
            continue

        if verify_ed25519_signature(pub_hex, sig_hex, digest_bytes):
            if pub_hex not in verified_keys:
                verified_keys.add(pub_hex)
                verified_signers.append({
                    "name": signer_name,
                    "public_key": pub_hex,
                    "algorithm": sig.get("algorithm", "ed25519"),
                })
        else:
            invalid_signatures += 1

    distinct_verified_count = len(verified_keys)
    # Both signatures must verify under two distinct keys
    is_verified = (distinct_verified_count >= 2)
    governance_status = "Accepted" if is_verified else "Proposed"

    result = {
        "path": str(doc_path.relative_to(REPO_ROOT)) if doc_path.is_relative_to(REPO_ROOT) else str(doc_path),
        "sha256": sha256_hex,
        "required_signatures": 2,
        "distinct_verified_count": distinct_verified_count,
        "verified_signers": verified_signers,
        "invalid_signatures_count": invalid_signatures,
        "status": governance_status,
        "verified": is_verified,
        "governance_note": (
            "H2 lever satisfied: Two distinct keys verified on canonical SHA-256."
            if is_verified
            else f"Status remains Proposed: {distinct_verified_count}/2 distinct signatures verified. Requires second cryptographic identity under Lever H2."
        )
    }

    return result


def sign_document(doc_path: Path, key_file_or_hex: str, signer_name: str) -> bool:
    """Sign a document detached and record into governance/signatures.json."""
    if not CRYPTO_AVAILABLE:
        print("Error: python cryptography library is required for signing.", file=sys.stderr)
        return False

    if not doc_path.exists():
        print(f"Error: Document {doc_path} not found.", file=sys.stderr)
        return False

    sha256_hex, digest_bytes = canonical_sha256(doc_path)

    # Load private key
    try:
        key_p = Path(key_file_or_hex)
        if key_p.exists():
            key_content = key_p.read_text(encoding="utf-8").strip()
        else:
            key_content = key_file_or_hex.strip()

        priv_bytes = bytes.fromhex(key_content)
        signing_key = ed25519.Ed25519PrivateKey.from_private_bytes(priv_bytes)
        pub_bytes = signing_key.public_key().public_bytes_raw()
    except Exception as e:
        print(f"Error loading private key: {e}", file=sys.stderr)
        return False

    # Detached Ed25519 signature over 32-byte digest
    sig_bytes = signing_key.sign(digest_bytes)
    sig_hex = sig_bytes.hex()
    pub_hex = pub_bytes.hex()

    rel_path = str(doc_path.relative_to(REPO_ROOT)) if doc_path.is_relative_to(REPO_ROOT) else str(doc_path)
    ledger = load_signatures_ledger()
    docs = ledger.setdefault("documents", {})

    if rel_path not in docs or docs[rel_path].get("sha256") != sha256_hex:
        docs[rel_path] = {
            "sha256": sha256_hex,
            "signatures": []
        }

    # Avoid duplicate signatures from same public key
    existing_sigs = [s for s in docs[rel_path]["signatures"] if s.get("public_key") != pub_hex]
    existing_sigs.append({
        "signer": signer_name,
        "algorithm": "ed25519",
        "public_key": pub_hex,
        "signature": sig_hex
    })
    docs[rel_path]["signatures"] = existing_sigs
    save_signatures_ledger(ledger)

    print(f"✓ Detached signature created for {rel_path}")
    print(f"  Signer: {signer_name}")
    print(f"  Public Key: {pub_hex}")
    print(f"  Document SHA-256: {sha256_hex}")
    sig_rel = get_signatures_file()
    try:
        sig_rel = sig_rel.relative_to(REPO_ROOT)
    except ValueError:
        pass
    print(f"  Stored in: {sig_rel}")
    return True


def keygen(output_prefix: str, signer_name: str):
    """Generate an Ed25519 governance keypair."""
    if not CRYPTO_AVAILABLE:
        print("Error: python cryptography library is required for keygen.", file=sys.stderr)
        sys.exit(1)

    priv = ed25519.Ed25519PrivateKey.generate()
    pub = priv.public_key()

    priv_hex = priv.private_bytes_raw().hex()
    pub_hex = pub.public_bytes_raw().hex()

    key_path = Path(f"{output_prefix}.key")
    pub_path = Path(f"{output_prefix}.pub")

    key_path.write_text(priv_hex + "\n", encoding="utf-8")
    pub_path.write_text(pub_hex + "\n", encoding="utf-8")
    os.chmod(key_path, 0o600)

    # Automatically register to signers if requested
    signers_data = load_signers()
    signers_list = signers_data.setdefault("signers", [])
    if not any(s.get("public_key") == pub_hex for s in signers_list):
        signers_list.append({
            "name": signer_name,
            "role": "Governance Key Holder",
            "public_key": pub_hex,
            "algorithm": "ed25519"
        })
        save_signers(signers_data)

    signers_rel = get_signers_file()
    try:
        signers_rel = signers_rel.relative_to(REPO_ROOT)
    except ValueError:
        pass

    print(f"✓ Generated governance keypair:")
    print(f"  Private key: {key_path} (mode 0600)")
    print(f"  Public key:  {pub_path}")
    print(f"  Signer Name: {signer_name}")
    print(f"  Registered in: {signers_rel}")
    print(f"\n[!NOTE] This key is for Document Accept Governance (Lever H2) ONLY.")
    print(f"[!CAUTION] Strictly prohibited for runtime engine unfreeze (P3 Signature Section 2).")


def check_unfreeze() -> bool:
    """
    Enforce Section 2: Runtime Unfreeze (Engine Execution)
    DO NOT RUN.
    - Constraint: No P_2/P_3 keygen, no out-of-band handshake, no Sedona compile for a ProofHash, and no R3-FREEZE clear.
    - Condition: Execution is suspended until a public path names the verifier, the freeze flag, and the proof object. That path does not currently exist.
    """
    print("==================================================================")
    print("Runtime Unfreeze Boundary Check (docs/P3 Signature.txt §2)")
    print("==================================================================")
    print("Constraint Verification:")
    print("  [✓] Execution status: SUSPENDED (DO NOT RUN)")
    print("  [✓] P_2/P_3 runtime unfreeze keygen: REFUSED / ABSENT")
    print("  [✓] Out-of-band handshake: ABSENT")
    print("  [✓] Sedona compile for ProofHash: UNBOUND / SUSPENDED")
    print("  [✓] R3-FREEZE flag: ACTIVE (Fail-closed)")
    print("  [✓] Separation of Concerns: Document Accept does NOT trigger engine unfreeze.")
    print("Condition Status:")
    print("  Public path naming verifier, freeze flag, and proof object does NOT currently exist.")
    print("==================================================================")
    print("Result: INVARIANT PRESERVED. System remains lawfully frozen.")
    print("==================================================================")
    return True


def main():
    parser = argparse.ArgumentParser(
        prog="git verify",
        description="Verify Phase Mirror P2-P3 signature requirements for governed ADR documents (docs/P3 Signature.txt & Lever H2)",
    )
    parser.add_argument(
        "files",
        nargs="*",
        help="Specific documents / ADR files to verify. If omitted, checks standard repository ADRs.",
    )
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Exit with non-zero code if any document is not fully verified (i.e. remains Proposed).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output full machine-readable verification verdict in JSON format.",
    )
    parser.add_argument(
        "--sign",
        metavar="FILE",
        help="Sign canonical bytes of FILE detached.",
    )
    parser.add_argument(
        "--key",
        metavar="KEY_FILE_OR_HEX",
        help="Private key for signing.",
    )
    parser.add_argument(
        "--signer",
        metavar="NAME",
        default="Governance Signer",
        help="Name of the signer identity.",
    )
    parser.add_argument(
        "--keygen",
        metavar="PREFIX",
        help="Generate an Ed25519 governance keypair with the specified prefix (e.g., p2_gov).",
    )
    parser.add_argument(
        "--register-signer",
        action="store_true",
        help="Register a new signer public key in governance/signers.json.",
    )
    parser.add_argument(
        "--pubkey",
        metavar="KEY_HEX_OR_FILE",
        help="Public key to register.",
    )
    parser.add_argument(
        "--check-unfreeze",
        action="store_true",
        help="Verify Section 2 Runtime Unfreeze suspension invariants.",
    )

    args = parser.parse_args()

    ensure_governance_files()

    if args.check_unfreeze:
        check_unfreeze()
        sys.exit(0)

    if args.keygen:
        keygen(args.keygen, args.signer)
        sys.exit(0)

    if args.register_signer:
        if not args.pubkey:
            print("Error: --pubkey is required with --register-signer", file=sys.stderr)
            sys.exit(1)
        pub_p = Path(args.pubkey)
        pub_hex = pub_p.read_text(encoding="utf-8").strip() if pub_p.exists() else args.pubkey.strip()
        data = load_signers()
        data.setdefault("signers", []).append({
            "name": args.signer,
            "role": "Governance Key Holder",
            "public_key": pub_hex,
            "algorithm": "ed25519"
        })
        save_signers(data)
        signers_rel = get_signers_file()
        try:
            signers_rel = signers_rel.relative_to(REPO_ROOT)
        except ValueError:
            pass
        print(f"✓ Registered signer '{args.signer}' ({pub_hex}) in {signers_rel}")
        sys.exit(0)

    if args.sign:
        if not args.key:
            print("Error: --key is required with --sign", file=sys.stderr)
            sys.exit(1)
        success = sign_document(Path(args.sign), args.key, args.signer)
        sys.exit(0 if success else 1)

    # Verification Mode
    targets = [Path(f) for f in args.files] if args.files else get_default_adr_files()
    if not targets:
        print("No documents specified and no default ADR files found.")
        sys.exit(0)

    results = []
    has_unverified = False

    for target in targets:
        res = verify_document(target, verbose=not args.json)
        results.append(res)
        if not res.get("verified", False):
            has_unverified = True

    if args.json:
        print(json.dumps({
            "governance_metric": "git verify (P2-P3 / H2 Lever)",
            "results": results,
            "all_accepted": not has_unverified,
        }, indent=2))
    else:
        print("\n==================================================================")
        print("Phase Mirror Governance — P2/P3 Signature Verification (Lever H2)")
        print("==================================================================")
        for r in results:
            path_str = r.get("path")
            sha = r.get("sha256", "UNKNOWN")
            status = r.get("status")
            distinct_count = r.get("distinct_verified_count", 0)
            verified = r.get("verified", False)

            status_color = "\033[92m" if verified else "\033[93m"
            reset_color = "\033[0m"

            print(f"\nDocument: {path_str}")
            print(f"  SHA-256 Digest: {sha}")
            print(f"  Signatures:     {distinct_count}/2 distinct valid signatures")
            for s in r.get("verified_signers", []):
                print(f"    - {s['name']} (Key: {s['public_key'][:16]}...)")
            print(f"  Status:         {status_color}{status}{reset_color}")
            print(f"  Verdict Note:   {r.get('governance_note')}")

        print("\n------------------------------------------------------------------")
        print(f"Total Governed Documents Checked: {len(results)}")
        if has_unverified:
            print("[!NOTE] Documents with < 2 distinct signatures remain lawfully Proposed.")
        else:
            print("[✓] All documents verified with 2 distinct cryptographic identities.")
        print("==================================================================\n")

    if args.strict and has_unverified:
        sys.exit(2)
    sys.exit(0)


if __name__ == "__main__":
    main()
