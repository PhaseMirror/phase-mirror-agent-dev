# phase-mirror-agent — environment template (ADR-009 §2.4).
#
# Copy to `.env` for local dev runs, or use as the source for the systemd
# EnvironmentFile (`/etc/phase-mirror/phase-mirror-agent.env`, chmod 0600).
# The schema is config/env.schema.json; unknown keys abort startup.
#
# Production minimums (PHASE_MIRROR_ENV=production):
#   - TLS cert/key OR PHASE_MIRROR_NO_TLS=true (explicit plain HTTP)
#   - a non-empty operator keyring (keys file or PHASE_MIRROR_OPERATOR_KEYS)

# Deployment environment: dev | production
#PHASE_MIRROR_ENV=dev

# HTTP listener address
#PHASE_MIRROR_BIND=0.0.0.0:8080

# Operator WebSocket broadcast port
#PHASE_MIRROR_WS_PORT=3030

# Allowed CORS origins (comma-separated; '*' is dev-only)
#PHASE_MIRROR_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Durable runtime state (audit WAL, archives)
#PHASE_MIRROR_STATE_DIR=./state

# Tools backplane config (ADR-008) and enabled real adapter families
#PHASE_MIRROR_TOOL_CONFIG=config/tools.toml
#PHASE_MIRROR_TOOL_ALLOW=compose,systemd

# Operator keyring — inline entries and/or a 0600 keys file (hashed at load)
#PHASE_MIRROR_OPERATOR_KEYS=
#PHASE_MIRROR_OPERATOR_KEYS_FILE=./config/keys/operator.keys

# Rate limiting (per-client)
#PHASE_MIRROR_RATE_LIMIT_RPS=10
#PHASE_MIRROR_RATE_LIMIT_BURST=20

# WebSocket bearer auth + dev loopback read exemption
#PHASE_MIRROR_WS_AUTH=false
#PHASE_MIRROR_LOOPBACK_EXCEPTION=true

# Logging (ADR-007 §2.1)
#PHASE_MIRROR_LOG_FORMAT=text
#PHASE_MIRROR_LOG_LEVEL=info

# TLS — production requires cert+key or explicit plain HTTP
#PHASE_MIRROR_TLS_CERT=./certs/tls.crt
#PHASE_MIRROR_TLS_KEY=./certs/tls.key
#PHASE_MIRROR_NO_TLS=false

# Reserved: mTLS CA for operator clients (not yet wired)
#PHASE_MIRROR_MTLS_CA=
